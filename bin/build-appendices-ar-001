#!/usr/bin/env python3
# Regenerates the ar-001 generated appendices (12.2, 12.6, 12.7) from the ar-001 topics.
# Run bin/build-locale-files ar-001 afterwards to refresh index.md, sitemap.xml, and peer ids.
import os, re, sys
from urllib.parse import unquote

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
L = "ar-001"
rows = [l.rstrip("\n").split("\t") for l in open(f"{root}/spec/topics.tsv")][1:]
slugs = {}
for l in open(f"{root}/locales/{L}/slugs.tsv"):
    p = l.rstrip("\n").split("\t")
    if len(p) >= 3:
        slugs[p[0]] = (p[1], p[2])
base = f"{root}/locales/{L}/المواضيع"

S_DEF = "تعريفات المقاييس"
S_GAME = "طرق التلاعب وضوابط الحماية"
S_REF = "المراجع والقراءة الإضافية"
FIRST = "المقياس"


def nk(n):
    return [int(x) for x in n.split(".")]


def read(num):
    return open(f"{base}/{slugs[num][0]}/index.md", encoding="utf-8").read()


def title(num):
    return slugs[num][1]


def sec(t, n):
    m = re.search(rf"^## {re.escape(n)}\n(.*?)(?=^## |\Z)", t, re.M | re.S)
    return m.group(1) if m else ""


def table(s, first):
    out = []
    for l in s.splitlines():
        if l.startswith("|") and not l.startswith("| ---") and not l.startswith(f"| {first} |"):
            out.append([x.strip() for x in l.strip().strip("|").split(" | ")])
    return out


def fmt(ns):
    return "، ".join(sorted(set(ns), key=nk))


part_title = {}
for part, num, slug, pt in rows:
    if num.endswith(".0") and int(part) < 12:
        part_title[part] = read(num).splitlines()[0].split(": ", 1)[1]

content = [(p, n, s, pt) for p, n, s, pt in rows if int(p) < 12]
texts = {n: read(n) for _, n, _, _ in content}

# ---------- 12.2 metric definitions ----------
o = []
total = 0
miss = []
cur = None
for part, num, slug, pt in content:
    if num.endswith(".0"):
        continue
    t = texts[num]
    md = table(sec(t, S_DEF), FIRST)
    gv = {c[0]: c for c in table(sec(t, S_GAME), FIRST) if len(c) == 3}
    if part != cur:
        o.append(f"\n## الجزء {part}: {part_title[part]}\n")
        cur = part
    o.append(f"### {num} {title(num)}\n")
    o.append(f"الموضوع الأصلي: (انظر الموضوع {num}، {title(num)}).\n")
    o.append("| المقياس | التعريف | الصيغة | الوحدة | مصدر البيانات | ممارسة ITIL | المقابل في أجايل | التكرار | طريقة التلاعب | ضابط الحماية |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
    for c in md:
        if len(c) != 8:
            miss.append((num, c[0], len(c)))
            continue
        g = gv.get(c[0])
        if not g:
            miss.append((num, c[0], "nogaming"))
            continue
        o.append("| " + " | ".join(c[:8] + [g[1], g[2]]) + " |")
        total += 1
    o.append("")
print("12.2 entries", total, "missing", miss, file=sys.stderr)
HEAD = ("# مرجع تعريفات المقاييس وصيغها\n\n"
        "يسرد هذا الملحق كل مقياس معرَّف في مواضيع المحتوى، مجمَّعًا بحسب الجزء والموضوع. ويحمل كل مدخل التعريف والصيغة والوحدة ومصدر البيانات وممارسة ITIL ذات الصلة والمقابل في أجايل والتكرار من الموضوع الأصلي، إضافة إلى طريقة التلاعب وضابط الحماية المقترن. وهو مولَّد من قسمي \"تعريفات المقاييس\" و\"طرق التلاعب وضوابط الحماية\" في كل موضوع، فالموضوع الأصلي هو المرجع: حيث يختلف مدخل هنا عن موضوعه يسود الموضوع ويُعاد توليد هذا الملحق.\n\n"
        "## كيف تستخدم هذا المرجع\n\n"
        "- **ابحث قبل أن تتبنى.** قبل إضافة مقياس إلى لوحة، اقرأ مدخله، بما فيه طريقة التلاعب وضابط الحماية، وتبنَّ ضابط الحماية معه (انظر الموضوع 1.3، النتائج قبل المخرجات: اختيار ما نقيسه).\n"
        "- **قِس الفرق والخدمات والأنظمة.** لا يُقصد بأي مدخل ترتيب الأفراد (انظر الموضوع 1.2، قانون غودهارت وعلم نفس المقاييس).\n"
        "- **فضّل الموضوع الأصلي للحكم.** الصيغ هنا قصيرة. أما تعريفات المصطلحات وتحفظات أخذ العينات والأمثلة العملية ففي الموضوع الأصلي.\n"
        "- **سجّل تنويعاتك.** إن غيّرت منظمتك تعريفًا فسجّل التغيير وسببه في فهرس قياساتك (انظر الموضوع 1.4، حوكمة المقاييس وملكيتها). وتساعد بطاقات القياس (انظر الموضوع 12.4، القوالب).\n"
        "- **الأرقام التوضيحية معلَّمة.** لا يحتوي هذا الملحق قيم معايير مرجعية. وأي رقم يأتي من خط أساسك أنت.\n")
open(f"{base}/{slugs['12.2'][0]}/index.md", "w", encoding="utf-8").write(HEAD + "\n".join(o))

# ---------- 12.6 references ----------
refs = {}
wiki = {}
for part, num, slug, pt in content:
    m = re.search(rf"^## {re.escape(S_REF)}\n(.*?)\Z", texts[num], re.M | re.S)
    if not m:
        continue
    for l in m.group(1).splitlines():
        mm = re.match(r"\d+\. (.*)", l)
        if not mm:
            continue
        r = mm.group(1).strip()
        if r.startswith("Wikipedia, "):
            wm = re.match(r"Wikipedia, \[(.*)\]\((.*)\)\.?$", r)
            wiki.setdefault(wm.group(2), [wm.group(1), []])[1].append(num)
        else:
            refs.setdefault(r, []).append(num)


def key(r):
    return re.sub(r"[^a-z0-9 ]", "", r.lower())


o = ["# المراجع والقراءة الإضافية", "",
     "يجمع هذا الملحق المراجع المذكورة في مواضيع المحتوى، مع المواضيع التي تذكر كلًّا منها. وتُرتَّب المداخل أبجديًا بحسب المؤلف أو الجهة. ويبقى الموضوع الأصلي هو المكان الذي يُرى فيه كيف يُستخدم مصدر.", "",
     "## عن التحقق", "",
     "رُوجع أن روابط ويكيبيديا في هذا الكتاب تعمل. أما الكتب والأوراق والمعايير ووثائق الإرشاد فقد ذكرها المؤلفون من الذاكرة ولم يُتحقق من كلها بعد مقابل الأصول. تعامل مع التفاصيل الببليوغرافية (السنوات والطبعات والعناوين) على أنها خيوط يلزم تأكيدها قبل الاعتماد عليها في عمل رسمي. وأبلغ عن التصحيحات عبر مهارة الصيانة.", "",
     "## الكتب والأوراق والمعايير والإرشاد", ""]
for i, r in enumerate(sorted(refs, key=key), 1):
    o.append(f"{i}. {r} (مذكور في {fmt(refs[r])})")
o += ["", "## مقالات ويكيبيديا", ""]
for i, (u, (ti, ns)) in enumerate(sorted(wiki.items(), key=lambda kv: kv[1][0].lower()), 1):
    o.append(f"{i}. Wikipedia, [{ti}]({u}) (مذكور في {fmt(ns)})")
open(f"{base}/{slugs['12.6'][0]}/index.md", "w", encoding="utf-8").write("\n".join(o) + "\n")
print("12.6", len(refs), len(wiki), file=sys.stderr)

# ---------- 12.7 index ----------
metrics = {}
concepts = {}
for num, t in texts.items():
    if num.endswith(".0"):
        continue
    for c in table(sec(t, S_DEF), FIRST):
        metrics.setdefault(c[0], []).append(num)
    body = t.split(f"## {S_REF}")[0]
    for m in re.finditer(r"\[([^\]]+)\]\((https://en\.wikipedia\.org/wiki/[^)\s]+(?:\([^)]*\))?)\)", body):
        label, url = m.group(1), m.group(2)
        ent = concepts.setdefault(url, [label, set()])
        ent[1].add(num)
FW = [("ITIL", None), ("DORA", None), ("SPACE", None), ("DevEx", None), ("OKR", None), ("GQM", None),
      ("Balanced scorecard", ["بطاقة الأداء المتوازن"]), ("Goal-Question-Metric", ["الهدف–السؤال–المقياس"]),
      ("Site reliability", ["موثوقية المواقع"]), ("Lean", ["الرشيق"]), ("Kanban Guide", ["دليل كانبان"]), ("COBIT", None),
      ("ISO/IEC 20000", None), ("ISO/IEC 27001", None), ("NIST", None), ("Cynefin", None),
      ("Value stream mapping", ["خريطة تدفق القيمة", "خرائط تدفق القيمة"]), ("HEART", None), ("Four Keys", None), ("Westrum", None),
      ("CMMI", None), ("FinOps", None), ("COPC", None), ("Team Topologies", None),
      ("Theory of constraints", ["نظرية القيود"])]
fw = {}
for f, aliases in FW:
    pats = [rf"\b{re.escape(f)}\b"] + [re.escape(a) for a in (aliases or [])]
    ns = [n for n, t in texts.items() if any(re.search(p, t.split(f"## {S_REF}")[0], re.I if p != pats[0] else 0) for p in pats)]
    if ns:
        fw[f"{aliases[0]} ({f})" if aliases else f] = sorted(ns, key=nk)
o = ["# الفهرس", "",
     "المفاهيم والأطر والمقاييس، كلٌّ منها يشير إلى المواضيع التي يظهر فيها. الأرقام هي أرقام المواضيع؛ والعناوين في جدول المحتويات في README وفي [البنية](../../../../spec/structure.md). وللتعريفات القصيرة ذات الموضوع الأصلي، انظر الموضوع 12.1، المسرد.", "",
     "## الأطر والنماذج", ""]
for f in sorted(fw, key=str.lower):
    ns = fw[f]
    o.append(f"- **{f}**: {fmt(ns) if len(ns) <= 12 else fmt(ns[:12]) + '، وغيرها'}")
o += ["", "## المقاييس", "",
      "أسماء المقاييس كما تظهر في جدول تعريفات كل موضوع. والمداخل الكاملة في الملحق 12.2 (انظر الموضوع 12.2، مرجع تعريفات المقاييس وصيغها).", ""]
for k in sorted(metrics, key=str.lower):
    o.append(f"- **{k}**: {fmt(metrics[k])}")
o += ["", "## المفاهيم", "",
      "المفاهيم هي المصطلحات التي ربطتها المواضيع بويكيبيديا للخلفية. والرقم الأول عادةً هو الموضوع الذي يشرح المفهوم بأكبر تفصيل.", ""]
for url, (label, ns) in sorted(concepts.items(), key=lambda kv: unquote(kv[0].rsplit("/", 1)[1]).replace("_", " ").lower()):
    en = unquote(url.rsplit("/", 1)[1]).replace("_", " ")
    shown = label if label.lower() == en.lower() else f"{label} ({en})"
    o.append(f"- **{shown}**: {fmt(ns)}")
open(f"{base}/{slugs['12.7'][0]}/index.md", "w", encoding="utf-8").write("\n".join(o) + "\n")
print("12.7", len(fw), len(metrics), len(concepts), file=sys.stderr)
