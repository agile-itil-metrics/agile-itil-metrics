#!/usr/bin/env python3
# Regenerates the generated appendices (12.2, 12.6, 12.7) of it-it, tr-tr, or th-th (and their -001 copies)
# from the locale's own topics.
#   bin/build-appendices-i18n it-it     (then bin/build-locale-files it-it)
# Run bin/build-locale-files afterwards to refresh index.md, sitemap.xml, and peer ids.
