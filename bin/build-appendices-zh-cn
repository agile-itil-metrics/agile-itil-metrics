#!/usr/bin/env python3
# Regenerates the zh-cn generated appendices (12.2, 12.6, 12.7) from the zh-cn topics.
# Run bin/build-locale-files zh-cn afterwards to refresh index.md, sitemap.xml, and peer ids.
import os, re, sys
from urllib.parse import unquote

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
L = "zh-cn"
rows = [l.rstrip("\n").split("\t") for l in open(f"{root}/spec/topics.tsv")][1:]
slugs = {}
for l in open(f"{root}/locales/{L}/slugs.tsv"):
    p = l.rstrip("\n").split("\t")
    if len(p) >= 3:
        slugs[p[0]] = (p[1], p[2])
base = f"{root}/locales/{L}/主题"


def nk(n):
    return [int(x) for x in n.split(".")]


def read(num):
    return open(f"{base}/{slugs[num][0]}/index.md").read()


def title(num):
    return slugs[num][1]


def sec(t, n):
    m = re.search(rf"^## {re.escape(n)}\n(.*?)(?=^## |\Z)", t, re.M | re.S)
    return m.group(1) if m else ""


def table(s, first):
    out = []
    for l in s.splitlines():
        if l.startswith("|") and not l.startswith("| ---") and not l.startswith(f"| {first} |"):
            out.append([x.strip() for x in l.strip().strip("|").split(" | ")])
    return out


def fmt(ns):
    return ", ".join(sorted(set(ns), key=nk))


part_title = {}
for part, num, slug, pt in rows:
    if num.endswith(".0") and int(part) < 12:
        part_title[part] = read(num).splitlines()[0].split("：", 1)[1]

content = [(p, n, s, pt) for p, n, s, pt in rows if int(p) < 12]
texts = {n: read(n) for _, n, _, _ in content}

# ---------- 12.2 metric definitions ----------
o = []
total = 0
miss = []
cur = None
for part, num, slug, pt in content:
    if num.endswith(".0"):
        continue
    t = texts[num]
    md = table(sec(t, "指标定义"), "指标")
    gv = {c[0]: c for c in table(sec(t, "操纵途径与护栏"), "指标") if len(c) == 3}
    if part != cur:
        o.append(f"\n## 第 {part} 部分：{part_title[part]}\n")
        cur = part
    o.append(f"### {num} {title(num)}\n")
    o.append(f"所属主题：（见主题 {num}，{title(num)}）。\n")
    o.append("| 指标 | 定义 | 公式 | 单位 | 数据来源 | ITIL 实践 | 敏捷对应 | 频率 | 操纵途径 | 护栏 |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
    for c in md:
        if len(c) != 8:
            miss.append((num, c[0], len(c)))
            continue
        g = gv.get(c[0])
        if not g:
            miss.append((num, c[0], "nogaming"))
            continue
        o.append("| " + " | ".join(c[:8] + [g[1], g[2]]) + " |")
        total += 1
    o.append("")
print("12.2 entries", total, "missing", miss, file=sys.stderr)
HEAD = ("# 指标定义与公式参考\n\n"
        "本附录列出内容主题中定义的每一项指标，按部分和主题分组。每个条目都带有来自所属主题的定义、公式、单位、数据来源、相关的 ITIL 实践、敏捷对应和频率，以及操纵途径和配套的护栏。它是根据每个主题的“指标定义”和“操纵途径与护栏”两节生成的，所以所属主题是权威：本处的条目与其主题有出入时，以主题为准，并重新生成本附录。\n\n"
        "## 如何使用本参考\n\n"
        "- **采用之前先查阅。**在把一项指标加入仪表板之前，先阅读其条目，包括操纵途径和护栏，并连同它一起采用护栏（见主题 1.3，结果优先于产出：选择衡量什么）。\n"
        "- **度量团队、服务和系统。**没有任何条目是用来给个人排名的（见主题 1.2，古德哈特定律与指标心理学）。\n"
        "- **判断请以所属主题为准。**这里的公式很简短。术语的定义、关于抽样的注意事项和实例都在所属主题中。\n"
        "- **记录你自己的变体。**如果你的组织更改了某项定义，请在指标目录中记录变更及其原因（见主题 1.4，指标治理与归属）。指标卡有帮助（见主题 12.4，模板）。\n"
        "- **示意数字会标明。**本附录不含基准值。任何数字都来自你自己的基线。\n")
open(f"{base}/{slugs['12.2'][0]}/index.md", "w").write(HEAD + "\n".join(o))

# ---------- 12.6 references ----------
refs = {}
wiki = {}
for part, num, slug, pt in content:
    m = re.search(r"^## 参考文献与延伸阅读\n(.*?)\Z", texts[num], re.M | re.S)
    if not m:
        continue
    for l in m.group(1).splitlines():
        mm = re.match(r"\d+\. (.*)", l)
        if not mm:
            continue
        r = mm.group(1).strip()
        if r.startswith("Wikipedia, "):
            wm = re.match(r"Wikipedia, \[(.*)\]\((.*)\)\.?$", r)
            wiki.setdefault(wm.group(2), [wm.group(1), []])[1].append(num)
        else:
            refs.setdefault(r, []).append(num)


def key(r):
    return re.sub(r"[^a-z0-9 ]", "", r.lower())


o = ["# 参考文献与延伸阅读", "",
     "本附录汇总内容主题中引用的参考文献，并列出引用每一项的主题。条目按作者或机构的字母顺序排列。所属主题仍是查看某项来源如何被使用的地方。", "",
     "## 关于核实", "",
     "本书中的 Wikipedia 链接已核对可以解析。书籍、论文、标准和指导文件是作者凭记忆引用的，尚未全部对照原件检查。在正式工作中依赖之前，请把书目细节（年份、版次、标题）视为有待确认的线索。请通过维护者技能报告更正。", "",
     "## 书籍、论文、标准与指南", ""]
for i, r in enumerate(sorted(refs, key=key), 1):
    o.append(f"{i}. {r}（引用于 {fmt(refs[r])}）")
o += ["", "## Wikipedia 条目", ""]
for i, (u, (ti, ns)) in enumerate(sorted(wiki.items(), key=lambda kv: kv[1][0].lower()), 1):
    o.append(f"{i}. Wikipedia, [{ti}]({u})（引用于 {fmt(ns)}）")
open(f"{base}/{slugs['12.6'][0]}/index.md", "w").write("\n".join(o) + "\n")
print("12.6", len(refs), len(wiki), file=sys.stderr)

# ---------- 12.7 index ----------
metrics = {}
concepts = {}
for num, t in texts.items():
    if num.endswith(".0"):
        continue
    for c in table(sec(t, "指标定义"), "指标"):
        metrics.setdefault(c[0], []).append(num)
    body = t.split("## 参考文献与延伸阅读")[0]
    for m in re.finditer(r"\[([^\]]+)\]\((https://en\.wikipedia\.org/wiki/[^)\s]+(?:\([^)]*\))?)\)", body):
        label, url = m.group(1), m.group(2)
        ent = concepts.setdefault(url, [label, set()])
        ent[1].add(num)
FW = [("ITIL", None), ("DORA", None), ("SPACE", None), ("DevEx", None), ("OKR", None), ("GQM", None),
      ("Balanced scorecard", "平衡计分卡"), ("Goal-Question-Metric", "目标-问题-度量"),
      ("Site reliability", "站点可靠性"), ("Lean", "精益"), ("Kanban Guide", None), ("COBIT", None),
      ("ISO/IEC 20000", None), ("ISO/IEC 27001", None), ("NIST", None), ("Cynefin", None),
      ("Value stream mapping", "价值流图"), ("HEART", None), ("Four Keys", None), ("Westrum", None),
      ("CMMI", None), ("FinOps", None), ("COPC", None), ("Team Topologies", None),
      ("Theory of constraints", "约束理论")]
fw = {}
for f, alias in FW:
    pats = [rf"\b{re.escape(f)}\b"] + ([re.escape(alias)] if alias else [])
    ns = [n for n, t in texts.items() if any(re.search(p, t.split("## 参考文献与延伸阅读")[0]) for p in pats)]
    if ns:
        fw[f"{alias}（{f}）" if alias else f] = sorted(ns, key=nk)
o = ["# 索引", "",
     "概念、框架和指标，每一项都指向其出现的主题。数字是主题编号；标题见 README 的目录和[结构](../../../../spec/structure.md)。如需带有所属主题的简短定义，见主题 12.1，术语表。", "",
     "## 框架与模型", ""]
for f in sorted(fw, key=str.lower):
    ns = fw[f]
    o.append(f"- **{f}**：{fmt(ns) if len(ns) <= 12 else fmt(ns[:12]) + '，等'}")
o += ["", "## 指标", "",
      "指标名称与各主题定义表中出现的一致。完整条目见附录 12.2（见主题 12.2，指标定义与公式参考）。", ""]
for k in sorted(metrics, key=str.lower):
    o.append(f"- **{k}**：{fmt(metrics[k])}")
o += ["", "## 概念", "",
      "概念取自各主题为背景知识链接到 Wikipedia 的术语。第一个编号通常是对该概念解释得最详细的主题。", ""]
for url, (label, ns) in sorted(concepts.items(), key=lambda kv: unquote(kv[0].rsplit("/", 1)[1]).replace("_", " ").lower()):
    en = unquote(url.rsplit("/", 1)[1]).replace("_", " ")
    shown = label if label.lower() == en.lower() else f"{label}（{en}）"
    o.append(f"- **{shown}**：{fmt(ns)}")
open(f"{base}/{slugs['12.7'][0]}/index.md", "w").write("\n".join(o) + "\n")
print("12.7", len(fw), len(metrics), len(concepts), file=sys.stderr)
