#!/usr/bin/env python3
# Regenerates the es-001 generated appendices (12.2, 12.6, 12.7) from the es-001 topics.
# Run bin/build-locale-files es-001 afterwards to refresh index.md, sitemap.xml, and peer ids.
import os, re, sys
from urllib.parse import unquote

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
L = "es-001"
rows = [l.rstrip("\n").split("\t") for l in open(f"{root}/spec/topics.tsv")][1:]
slugs = {}
for l in open(f"{root}/locales/{L}/slugs.tsv"):
    p = l.rstrip("\n").split("\t")
    if len(p) >= 3:
        slugs[p[0]] = (p[1], p[2])
base = f"{root}/locales/{L}/temas"

S_DEF = "Definiciones de métricas"
S_GAME = "Vectores de manipulación y barreras de protección"
S_REF = "Referencias y lecturas complementarias"
FIRST = "Métrica"


def nk(n):
    return [int(x) for x in n.split(".")]


def read(num):
    return open(f"{base}/{slugs[num][0]}/index.md").read()


def title(num):
    return slugs[num][1]


def sec(t, n):
    m = re.search(rf"^## {re.escape(n)}\n(.*?)(?=^## |\Z)", t, re.M | re.S)
    return m.group(1) if m else ""


def table(s, first):
    out = []
    for l in s.splitlines():
        if l.startswith("|") and not l.startswith("| ---") and not l.startswith(f"| {first} |"):
            out.append([x.strip() for x in l.strip().strip("|").split(" | ")])
    return out


def fmt(ns):
    return ", ".join(sorted(set(ns), key=nk))


part_title = {}
for part, num, slug, pt in rows:
    if num.endswith(".0") and int(part) < 12:
        part_title[part] = read(num).splitlines()[0].split(": ", 1)[1]

content = [(p, n, s, pt) for p, n, s, pt in rows if int(p) < 12]
texts = {n: read(n) for _, n, _, _ in content}

# ---------- 12.2 metric definitions ----------
o = []
total = 0
miss = []
cur = None
for part, num, slug, pt in content:
    if num.endswith(".0"):
        continue
    t = texts[num]
    md = table(sec(t, S_DEF), FIRST)
    gv = {c[0]: c for c in table(sec(t, S_GAME), FIRST) if len(c) == 3}
    if part != cur:
        o.append(f"\n## Parte {part}: {part_title[part]}\n")
        cur = part
    o.append(f"### {num} {title(num)}\n")
    o.append(f"Tema de origen: (véase el tema {num}, {title(num)}).\n")
    o.append("| Métrica | Definición | Fórmula | Unidad | Fuente de datos | Práctica de ITIL | Equivalente ágil | Cadencia | Vector de manipulación | Barrera de protección |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |")
    for c in md:
        if len(c) != 8:
            miss.append((num, c[0], len(c)))
            continue
        g = gv.get(c[0])
        if not g:
            miss.append((num, c[0], "nogaming"))
            continue
        o.append("| " + " | ".join(c[:8] + [g[1], g[2]]) + " |")
        total += 1
    o.append("")
print("12.2 entries", total, "missing", miss, file=sys.stderr)
HEAD = ("# Referencia de definiciones y fórmulas de métricas\n\n"
        "Este apéndice enumera todas las métricas definidas en los temas de contenido, agrupadas por parte y por tema. Cada entrada lleva la definición, la fórmula, la unidad, la fuente de datos, la práctica de ITIL relacionada, el equivalente ágil y la cadencia del tema de origen, junto con el vector de manipulación y la barrera de protección emparejada. Se genera a partir de las secciones \"Definiciones de métricas\" y \"Vectores de manipulación y barreras de protección\" de cada tema, así que el tema de origen es la autoridad: cuando una entrada de aquí difiere de su tema, prevalece el tema, y este apéndice se regenera.\n\n"
        "## Cómo usar esta referencia\n\n"
        "- **Consulta antes de adoptar.** Antes de añadir una métrica a un panel, lee su entrada, incluidos el vector de manipulación y la barrera de protección, y adopta la barrera de protección con ella (véase el tema 1.3, Resultados sobre producción: elegir qué medir).\n"
        "- **Mide equipos, servicios y sistemas.** Ninguna entrada está pensada para clasificar a individuos (véase el tema 1.2, Ley de Goodhart y psicología de las métricas).\n"
        "- **Prefiere el tema de origen para el criterio.** Las fórmulas de aquí son breves. Las definiciones de los términos, las salvedades sobre el muestreo y los ejemplos trabajados están en el tema de origen.\n"
        "- **Registra tus propias variaciones.** Si tu organización cambia una definición, registra el cambio y la razón en tu catálogo de métricas (véase el tema 1.4, Gobernanza y propiedad de las métricas). Las fichas de métricas ayudan (véase el tema 12.4, Plantillas).\n"
        "- **Las cifras ilustrativas están marcadas.** Este apéndice no contiene valores de referencia. Cualquier número proviene de tu propia línea base.\n")
open(f"{base}/{slugs['12.2'][0]}/index.md", "w").write(HEAD + "\n".join(o))

# ---------- 12.6 references ----------
refs = {}
wiki = {}
for part, num, slug, pt in content:
    m = re.search(rf"^## {re.escape(S_REF)}\n(.*?)\Z", texts[num], re.M | re.S)
    if not m:
        continue
    for l in m.group(1).splitlines():
        mm = re.match(r"\d+\. (.*)", l)
        if not mm:
            continue
        r = mm.group(1).strip()
        if r.startswith("Wikipedia, "):
            wm = re.match(r"Wikipedia, \[(.*)\]\((.*)\)\.?$", r)
            wiki.setdefault(wm.group(2), [wm.group(1), []])[1].append(num)
        else:
            refs.setdefault(r, []).append(num)


def key(r):
    return re.sub(r"[^a-z0-9 ]", "", r.lower())


o = ["# Referencias y lecturas complementarias", "",
     "Este apéndice reúne las referencias citadas en los temas de contenido, con los temas que citan cada una. Las entradas se enumeran por orden alfabético de autor u organismo. El tema de origen sigue siendo el lugar donde ver cómo se usa una fuente.", "",
     "## Acerca de la verificación", "",
     "Se ha comprobado que los enlaces de Wikipedia de este libro se resuelven. Los autores citaron de memoria libros, artículos, normas y documentos de orientación, y no todos se han contrastado todavía con los originales. Trata los datos bibliográficos (años, ediciones, títulos) como pistas que confirmar antes de basarte en ellos en trabajos formales. Informa de las correcciones mediante la habilidad de mantenimiento.", "",
     "## Libros, artículos, normas y orientación", ""]
for i, r in enumerate(sorted(refs, key=key), 1):
    o.append(f"{i}. {r} (citado en {fmt(refs[r])})")
o += ["", "## Artículos de Wikipedia", ""]
for i, (u, (ti, ns)) in enumerate(sorted(wiki.items(), key=lambda kv: kv[1][0].lower()), 1):
    o.append(f"{i}. Wikipedia, [{ti}]({u}) (citado en {fmt(ns)})")
open(f"{base}/{slugs['12.6'][0]}/index.md", "w").write("\n".join(o) + "\n")
print("12.6", len(refs), len(wiki), file=sys.stderr)

# ---------- 12.7 index ----------
metrics = {}
concepts = {}
for num, t in texts.items():
    if num.endswith(".0"):
        continue
    for c in table(sec(t, S_DEF), FIRST):
        metrics.setdefault(c[0], []).append(num)
    body = t.split(f"## {S_REF}")[0]
    for m in re.finditer(r"\[([^\]]+)\]\((https://en\.wikipedia\.org/wiki/[^)\s]+(?:\([^)]*\))?)\)", body):
        label, url = m.group(1), m.group(2)
        ent = concepts.setdefault(url, [label, set()])
        ent[1].add(num)
FW = [("ITIL", None), ("DORA", None), ("SPACE", None), ("DevEx", None), ("OKR", None), ("GQM", None),
      ("Balanced scorecard", "Cuadro de mando integral"), ("Goal-Question-Metric", "Meta-Pregunta-Métrica"),
      ("Site reliability", "Fiabilidad de sitios"), ("Lean", None), ("Kanban Guide", None), ("COBIT", None),
      ("ISO/IEC 20000", None), ("ISO/IEC 27001", None), ("NIST", None), ("Cynefin", None),
      ("Value stream mapping", "Mapeo del flujo de valor"), ("HEART", None), ("Four Keys", None), ("Westrum", None),
      ("CMMI", None), ("FinOps", None), ("COPC", None), ("Team Topologies", None),
      ("Theory of constraints", "Teoría de las restricciones")]
fw = {}
for f, alias in FW:
    pats = [rf"\b{re.escape(f)}\b"] + ([re.escape(alias)] if alias else [])
    ns = [n for n, t in texts.items() if any(re.search(p, t.split(f"## {S_REF}")[0], re.I if p != pats[0] else 0) for p in pats)]
    if ns:
        fw[f"{alias} ({f})" if alias else f] = sorted(ns, key=nk)
o = ["# Índice", "",
     "Conceptos, marcos y métricas, cada uno con los temas donde aparece. Los números son números de tema; los títulos están en la tabla de contenidos del README y en la [estructura](../../../../spec/structure.md). Para definiciones breves con un tema de origen, véase el tema 12.1, Glosario.", "",
     "## Marcos y modelos", ""]
for f in sorted(fw, key=str.lower):
    ns = fw[f]
    o.append(f"- **{f}**: {fmt(ns) if len(ns) <= 12 else fmt(ns[:12]) + ', y otros'}")
o += ["", "## Métricas", "",
      "Nombres de métricas tal como aparecen en la tabla de definiciones de cada tema. Las entradas completas están en el apéndice 12.2 (véase el tema 12.2, Referencia de definiciones y fórmulas de métricas).", ""]
for k in sorted(metrics, key=str.lower):
    o.append(f"- **{k}**: {fmt(metrics[k])}")
o += ["", "## Conceptos", "",
      "Los conceptos son los términos que los temas enlazan con Wikipedia como contexto. El primer número suele ser el tema que explica el concepto con más detalle.", ""]
for url, (label, ns) in sorted(concepts.items(), key=lambda kv: unquote(kv[0].rsplit("/", 1)[1]).replace("_", " ").lower()):
    en = unquote(url.rsplit("/", 1)[1]).replace("_", " ")
    shown = label if label.lower() == en.lower() else f"{label} ({en})"
    o.append(f"- **{shown}**: {fmt(ns)}")
open(f"{base}/{slugs['12.7'][0]}/index.md", "w").write("\n".join(o) + "\n")
print("12.7", len(fw), len(metrics), len(concepts), file=sys.stderr)
